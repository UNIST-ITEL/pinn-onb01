# =============================================================================
# PINN-ONB01 — .gitignore
# Minimal set: keep source, manuscript, configs, analysis reports.
# Exclude generated artifacts, large binaries, third-party PDFs, backups.
# =============================================================================

# ---------------------------------------------------------------------------
# Backup files (three generations preserved locally)
# ---------------------------------------------------------------------------
*.bak
*.bak[0-9]*
*.bak_*

# ---------------------------------------------------------------------------
# Python build artifacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments (all phases)
# ---------------------------------------------------------------------------
.venv/
venv/
env/
.env/

# ---------------------------------------------------------------------------
# Survey — third-party literature PDFs (copyright)
# ---------------------------------------------------------------------------
phase1_pool_boiling/01_survey/pdfs/
phase1_pool_boiling/01_survey/raw/

# ---------------------------------------------------------------------------
# Data — raw literature PDFs / WPD raw exports, large generated files
# Keep: 02_data/processed/*.csv, 02_data/surface_cards/, 02_data/scripts/
# Also keep: experiment templates + guides (documentation, not raw data)
# Note: parent 02_data/raw/ is NOT directly ignored so per-subdirectory
# inclusions work; specific raw-data subdirs are excluded instead.
# (Phase 1 folders relocated under phase1_pool_boiling/ on 2026-05-27.)
# ---------------------------------------------------------------------------
phase1_pool_boiling/02_data/raw/literature/
phase1_pool_boiling/02_data/raw/synthetic/
phase1_pool_boiling/02_data/raw/.DS_Store

# Phase 2 — third-party literature PDFs (copyright)
# ---------------------------------------------------------------------------
phase2_flow_boiling/data/raw/literature/pdfs/
# Inside experiment/: keep only templates + docs, ignore actual measurement CSVs
phase1_pool_boiling/02_data/raw/experiment/*
!phase1_pool_boiling/02_data/raw/experiment/*template*.csv
!phase1_pool_boiling/02_data/raw/experiment/MEASUREMENT_GUIDE.md
!phase1_pool_boiling/02_data/raw/experiment/README.md
phase1_pool_boiling/02_data/wpd_raw/
phase1_pool_boiling/02_data/external/
phase1_pool_boiling/02_data/processed/*.npz
phase1_pool_boiling/02_data/processed/*.h5

# Phase 1.5: xlsx inventory는 commit, export된 CSV는 ignore (재생성 가능)
phase1p5_inhouse_augmentation/data/processed/boiling_curves_v1p5_partial.csv
phase1p5_inhouse_augmentation/data/processed/onb_dataset_v1p5_partial.csv
phase1p5_inhouse_augmentation/data/processed/surface_metadata.csv
phase1p5_inhouse_augmentation/data/processed/overview.csv
# 최종 v1p5 통합 CSV 도 (preprocess-pipeline 생성물, 재생성 가능)
phase1p5_inhouse_augmentation/data/processed/boiling_curves_v1p5.csv
phase1p5_inhouse_augmentation/data/processed/onb_dataset_v1p5.csv

# ---------------------------------------------------------------------------
# Model — checkpoints, training/inference logs, MLflow runs
# Keep: 03_model/configs/, 03_model/src/
# ---------------------------------------------------------------------------
phase1_pool_boiling/03_model/checkpoints/
phase1_pool_boiling/03_model/experiments/
phase1_pool_boiling/03_model/logs/
phase1_pool_boiling/03_model/wandb/
phase1_pool_boiling/03_model/mlruns/

# ---------------------------------------------------------------------------
# Analysis — generated figures, large outputs
# Keep: 04_analysis/scripts/, 04_analysis/*.md, 04_analysis/tables/
# ---------------------------------------------------------------------------
phase1_pool_boiling/04_analysis/figures/
phase1_pool_boiling/04_analysis/*.png
phase1_pool_boiling/04_analysis/*.pdf
phase1_pool_boiling/04_analysis/*.eps

# ---------------------------------------------------------------------------
# Manuscript — generated figures and LaTeX build artifacts
# Keep: 05_manuscript/*.tex, *.bib, sections/, supplementary/*.tex
# ---------------------------------------------------------------------------
phase1_pool_boiling/05_manuscript/figures/
phase1_pool_boiling/05_manuscript/main.pdf
phase1_pool_boiling/05_manuscript/main.docx
phase1_pool_boiling/05_manuscript/main.spl
phase1_pool_boiling/05_manuscript/cover_letter.pdf
phase1_pool_boiling/05_manuscript/supplementary.pdf
phase1_pool_boiling/05_manuscript/supplementary/*.pdf
phase1_pool_boiling/05_manuscript/supplementary/*.docx

# Submission build outputs (regenerable from sources)
phase1_pool_boiling/05_manuscript/SUBMISSION/*.pdf
phase1_pool_boiling/05_manuscript/SUBMISSION/*.zip
phase1_pool_boiling/05_manuscript/SUBMISSION/figures_pdf/

# LaTeX auxiliary files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lot
*.lof
*.nav
*.snm
*.vrb

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db
desktop.ini

# OneDrive 충돌 복사본 — 2개 이상 host 가 동일 파일 동시 수정 시 자동 생성됨
# (가이드 § 8.1 참조). commit 에 끼지 않도록 차단.
*의 충돌 복사본*
* (*의 충돌 복사본)*
*Conflicted copy*
* (Conflicted Copy*)*
*-conflict-*

# ---------------------------------------------------------------------------
# Presentations — keep final PDFs + .md only; exclude editable sources
# (per workspace policy in presentations/README.md).
# Final PDFs go in: phase*/presentations/{slides,posters,reports,outreach}/
# Source files (.pptx, .key, .docx) are kept in external storage (OneDrive).
# ---------------------------------------------------------------------------
**/presentations/**/*.pptx
**/presentations/**/*.ppt
**/presentations/**/*.key
**/presentations/**/*.docx
**/presentations/**/*.doc
**/presentations/**/*.ai
**/presentations/**/*.psd
**/presentations/**/*.sketch
**/presentations/**/*.fig
# PowerPoint / Word lock + temp files
**/presentations/**/~$*
**/presentations/**/*.tmp
**/presentations/**/.~lock.*
# Slides archive (working drafts kept local only) — keep .gitkeep for structure
**/presentations/**/slides/archive/*
!**/presentations/**/slides/archive/.gitkeep
# README.md 항상 포함 (folder 사용법)
!**/presentations/**/README.md
# .gitkeep 항상 포함 (빈 folder 구조 유지)
!**/presentations/**/.gitkeep

# ---------------------------------------------------------------------------
# Local Claude / agent transient files
# ---------------------------------------------------------------------------
.claude/local/
.claude/cache/

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.tmp
*.temp
.env
.env.local
.env.*.local
